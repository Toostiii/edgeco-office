# EDGECO Office — Umgebungsvariablen
# Kopiere diese Datei zu .env.local und trage deine Supabase-Werte ein.
# (.env.local ist in .gitignore und wird NICHT eingecheckt.)

# --- Supabase: Projekt-API (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://DEIN-PROJEKT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="DEIN-ANON-PUBLIC-KEY"

# --- Postgres-Verbindung für Drizzle-Migrationen (Settings → Database) ---
# WICHTIG: Transaction-Pooler-URL (Port 6543) verwenden.
DATABASE_URL="postgresql://postgres.DEIN-REF:DEIN-PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
